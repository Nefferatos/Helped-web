          "expect": {
            "files": {
              "mode": "chose"
            },
            "outputType": {
              "label": "Text"
            },
            "defaultModel": {
              "mode": "chose",
              "label": "GPT-6 LunaThe most efficient GPT-6 model for focused, high-volume tasks"
            },
            "promptCaching": {
              "label": "Automatic (always on)"
            },
            "reasoningEffort": {
              "mode": "chose",
              "label": "Low"
