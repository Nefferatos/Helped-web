      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com",
    "notes": [
      "Orchestrator: routes AI-classifier output to backend endpoints.",
      "On import: set WORKER_BASE_URL variable to your backend URL (e.g. http://localhost:3000).",
      "The make_pipeline route posts to /api/inquiry/make which relays results back into Make when configured."
    ]
