{
  "name": "Helped Maids – Full Workflow Orchestrator (Latest)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 2957274, "maxResults": 1 },
      "mapper": {},
      "metadata": { "designer": { "x": -1060, "y": 552 } }
    },
    {
      "id": 10,
      "module": "ai-local-agent:RunLocalAIAgent",
      "version": 0,
      "parameters": { "makeConnectionId": 7082764 },
      "mapper": {
        "defaultModel": "gpt-5.4",
        "reasoningEffort": "low",
        "systemPrompt": "You are a workflow classifier for a maid agency platform. Choose exactly one workflow from: lead_scoring, inquiry_only, inquiry_match, make_pipeline, contract_creation, schedule_creation, notification_only, human_review. Return JSON with keys 'workflow' and 'payload'. Do not use markdown or explain.",
        "message": "Action: {{1.action}}\nCustomer name: {{ifempty(1.customer.name; '')}}\nMessage: {{ifempty(1.message; '')}}",
        "threadId": "{{1.customer.contact}}-{{ifempty(1.context.employerId; 'guest')}}",
        "modelConfig": {
          "recursionLimit": 300,
          "iterationsFromHistoryCount": "10"
        },
        "outputType": "text"
      },
      "metadata": { "designer": { "x": -698, "y": 545 }, "tools": [] }
    },
    {
      "id": 12,
      "module": "json:ParseJSON",
      "version": 1,
      "mapper": { "json": "{{10.response}}" },
      "metadata": { "designer": { "x": -374, "y": 549 } }
    },
    {
      "id": 14,
      "module": "builtin:BasicRouter",
      "version": 1,
      "routes": [
        {
          "flow": [
            {
              "id": 15,
              "module": "http:MakeRequest",
              "version": 4,
              "filter": {
                "name": "Inquiry Only",
                "conditions": [
                  [
                    {
                      "a": "{{12.workflow}}",
                      "o": "text:equal",
                      "b": "inquiry_only"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "{{WORKER_BASE_URL}}/api/inquiry",
                "method": "post",
                "headers": [
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "contentType": "custom",
                "rawBodyContent": "{\"name\":\"{{12.payload.name}}\",\"contact\":\"{{12.payload.contact}}\",\"message\":\"{{12.payload.message}}\"}"
              }
            },
            {
              "id": 28,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "mapper": {
                "body": "{\"ok\": true, \"workflow\": \"{{12.workflow}}\", \"statusCode\": {{15.statusCode}} }",
                "status": "200"
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 16,
              "module": "http:MakeRequest",
              "version": 4,
              "filter": {
                "name": "Lead Scoring",
