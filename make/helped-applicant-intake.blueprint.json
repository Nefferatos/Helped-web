{
  "name": "Helped Maids - Applicant Intake (EVENT-DRIVEN)",
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": { "roundtrips": 1, "maxErrors": 3, "autoCommit": true, "autoCommitTriggerLast": true, "sequential": false, "confidential": false, "dataloss": false, "dlq": false }
  },
  "flow": [
    {
      "id": 2,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 0, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": -600, "y": 0 },
        "restore": { "parameters": { "hook": { "data": { "editable": "true" } } } },
        "notes": "TRIGGER: replaces the old 15-minute Supabase poll. The backend fires this webhook as soon as it records candidate.created. On import, create a webhook named Applicant Intake (event), then set MAKE_WEBHOOK_URL_APPLICANT_INTAKE in the backend environment."
      }
    },
    {
      "id": 9,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLIB": true },
      "mapper": {
        "url": "https://YOUR-PROJECT-REF.supabase.co/rest/v1/helped_query_ats_profiles",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          { "name": "apikey", "value": "SUPABASE_SERVICE_ROLE_KEY" },
          { "name": "Authorization", "value": "Bearer SUPABASE_SERVICE_ROLE_KEY" }
        ],
        "qs": [
          { "name": "select", "value": "full_name,email,contact_number,nationality,years_of_experience,expected_salary,payload" },
          { "name": "application_id", "value": "eq.{{2.application_id}}" },
          { "name": "limit", "value": "1" }
        ],
        "bodyType": "raw",
        "parseResponse": true,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json"
      },
      "metadata": { "designer": { "x": -300, "y": 0 }, "restore": {}, "notes": "Fetch the matching applicant profile. Replace YOUR-PROJECT-REF and SUPABASE_SERVICE_ROLE_KEY." }
    },
    {
      "id": 4,
      "module": "ai-local-agent:RunLocalAIAgent",
      "version": 0,
      "parameters": {},
      "mapper": {
        "defaultModel": "gpt-4o-mini",
        "reasoningEffort": "low",
        "systemPrompt": "You are a recruitment screener for Helped Maids, a Singapore foreign-domestic-worker agency. Given an applicant profile, write a concise recruiter briefing: a two-line summary, top strengths, any red flags, and one recommended next stage from this exact ladder: Documents Submitted, Resume Parsed, Screening Interview, Rejected. Return plain text only. Do not use markdown.",
        "message": "Applicant: {{9.data.1.full_name}}\nNationality: {{9.data.1.nationality}}\nYears experience: {{9.data.1.years_of_experience}}\nExpected salary: {{9.data.1.expected_salary}}\nContact: {{9.data.1.contact_number}} / {{9.data.1.email}}\nApplication code: {{2.application_code}}\nFull payload: {{9.data.1.payload}}",
        "threadId": "applicant-{{2.application_id}}",
        "modelConfig": { "recursionLimit": 20, "iterationsFromHistoryCount": "0" },
        "outputType": "text"
      },
      "metadata": { "designer": { "x": 0, "y": 0 }, "restore": {}, "notes": "Make AI Agent. After import, choose a Make AI Provider connection and model; no Anthropic HTTP API key is required." },
      "tools": []
    },
    {
      "id": 10,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLIB": true },
      "mapper": {
        "url": "https://YOUR-DOMAIN/api/events",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          { "name": "content-type", "value": "application/json" },
          { "name": "x-event-secret", "value": "EVENT_INGEST_SECRET" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json",
        "data": "{\n  \"event_type\": \"screening.completed\",\n  \"entity_type\": \"application\",\n  \"entity_id\": \"{{2.application_id}}\",\n  \"actor\": \"make:applicant-intake\",\n  \"status\": \"completed\",\n  \"payload\": {\n    \"application_code\": \"{{2.application_code}}\",\n    \"full_name\": \"{{9.data.1.full_name}}\",\n    \"screening\": {{toJSON(4.response)}}\n  }\n}"
      },
      "metadata": { "designer": { "x": 300, "y": -150 }, "restore": {}, "notes": "Report screening.completed to the operator. Replace YOUR-DOMAIN and EVENT_INGEST_SECRET." }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": { "designer": { "x": 560, "y": 50 } },
      "routes": [
        {
          "flow": [
            {
              "id": 5,
              "module": "google-email:ActionSendEmail",
              "version": 2,
              "parameters": { "account": "" },
              "mapper": {
                "cc": [],
                "to": ["wow.aisolution@gmail.com"],
                "bcc": [],
                "from": "",
                "subject": "New FDW Applicant: {{9.data.1.full_name}} ({{2.application_code}}) - Review in ATS",
                "html": "<p><strong>New applicant received via the public form.</strong></p><p><strong>Name:</strong> {{9.data.1.full_name}}<br><strong>Nationality:</strong> {{9.data.1.nationality}}<br><strong>Experience:</strong> {{9.data.1.years_of_experience}} yrs<br><strong>Expected salary:</strong> {{9.data.1.expected_salary}}<br><strong>Contact:</strong> {{9.data.1.contact_number}} / {{9.data.1.email}}<br><strong>Code:</strong> {{2.application_code}} &nbsp; <strong>Stage:</strong> {{2.status}}</p><hr><p><strong>AI screening briefing:</strong></p><p>{{replace(4.response; newline; \"<br>\")}}</p><hr><p>Open the recruiter dashboard to advance the stage.</p>",
                "attachments": []
              },
              "metadata": { "designer": { "x": 860, "y": -150 }, "restore": { "parameters": { "account": { "data": { "scoped": "true", "connection": "google-restricted" } } } }, "notes": "Recruiter alert. After import, select or create a Gmail connection in this module." }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLIB": true },
              "mapper": {
                "url": "https://api.telegram.org/botTELEGRAM_BOT_TOKEN/sendMessage",
                "serializeUrl": false,
                "method": "post",
                "headers": [],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "rejectUnauthorized": true,
                "gzip": true,
                "contentType": "application/json",
                "data": "{\n  \"chat_id\": \"RECRUITER_TELEGRAM_CHAT_ID\",\n  \"parse_mode\": \"HTML\",\n  \"text\": \"<b>New applicant</b> {{9.data.1.full_name}} ({{2.application_code}})\\n{{9.data.1.nationality}} / {{9.data.1.years_of_experience}}y / expected salary {{9.data.1.expected_salary}}\\n{{4.response}}\"\n}"
              },
              "metadata": { "designer": { "x": 860, "y": 150 }, "restore": {}, "notes": "Optional recruiter Telegram notification. Replace TELEGRAM_BOT_TOKEN and RECRUITER_TELEGRAM_CHAT_ID." }
            }
          ]
        }
      ]
    }
  ]
}
