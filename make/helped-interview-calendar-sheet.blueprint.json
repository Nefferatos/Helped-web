{
  "name": "Helped - Interview Calendar and Sheet Sync",
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": true,
      "dataloss": false,
      "dlq": false
    },
    "notes": [
      "Dedicated interview invitation pipeline for MAKE_WEBHOOK_URL_INTERVIEW_PIPELINE. Creates a private Calendar event, emails the candidate through Calendar guest notifications, writes one Google Sheets row, and returns the event id/URL and row number to the website. A video meeting URL must be supplied by the website or verified in the Calendar module output; this blueprint does not guarantee Google Meet generation. Reschedules update the saved Calendar event and existing sheet row. Reconnect Google Calendar and Google Sheets and select the agency calendar/spreadsheet after import."
    ],
    "designer": { "orphans": [] }
  },
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 0, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": -300, "y": 300 },
        "restore": { "parameters": { "hook": { "data": { "editable": "true" } } } },
        "notes": "Create a new custom webhook for this scenario. Set its URL as MAKE_WEBHOOK_URL_INTERVIEW_PIPELINE. Do not reuse the generic orchestrator or staff-alert webhook."
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 0, "y": 300 } },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "google-calendar:createAnEvent",
              "version": 5,
              "parameters": { "__IMTCONN__": "" },
              "mapper": {
                "select": "detail",
                "calendar": "primary",
                "summary": "Interview with {{1.candidateName}} - At The Agency",
                "allDayEvent": false,
                "start": "{{parseDate(concat(1.scheduledDate; \" \"; 1.scheduledTime24); \"YYYY-MM-DD HH:mm\"; \"Asia/Singapore\")}}",
                "end": "{{addMinutes(parseDate(concat(1.scheduledDate; \" \"; 1.scheduledTime24); \"YYYY-MM-DD HH:mm\"; \"Asia/Singapore\"); ifempty(1.durationMinutes; 30))}}",
                "description": "At The Agency interview\nInterview ID: {{1.interviewId}}\nFormat: {{1.interviewMode}}\nApplication ID: {{1.applicationId}}\n{{ifempty(1.meetingUrl; \"\")}}",
                "location": "{{if(1.interviewMode = \"in_person\"; \"At The Agency\"; ifempty(1.meetingUrl; \"\"))}}",
                "attendees": [{ "email": "{{1.to}}", "displayName": "{{1.candidateName}}" }],
                "transparency": "opaque",
                "visibility": "private",
                "sendUpdates": "all",
                "guestsCanModify": false
              },
              "metadata": {
                "designer": { "x": 300, "y": 0 },
                "restore": {
                  "expect": {
                    "select": { "label": "In Detail" },
                    "calendar": { "mode": "chose", "label": "Select the agency calendar after import" },
                    "visibility": { "mode": "chose", "label": "Private" },
                    "sendUpdates": { "mode": "chose", "label": "All" }
                  },
                  "parameters": { "__IMTCONN__": { "data": { "scoped": "true", "connection": "google" } } }
                },
                "notes": "Connect the agency Google account and select the calendar. Calendar invitations go to the candidate email supplied by the website. For video interviews, include a verified meetingUrl in the website record; the Calendar module's conferencing output is used only when it provides one."
              }
            },
            {
              "id": 4,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": { "__IMTCONN__": "" },
              "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "REPLACE_AFTER_IMPORT",
                "sheetId": "Interviews",
                "includesHeaders": true,
                "insertDataOption": "INSERT_ROWS",
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "0": "{{1.interviewId}}",
                  "1": "{{1.applicationId}}",
                  "2": "{{1.candidateName}}",
                  "3": "{{1.to}}",
                  "4": "{{1.scheduledDate}}",
                  "5": "{{1.scheduledTime24}}",
                  "6": "{{1.interviewMode}}",
                  "7": "{{3.hangoutLink}}",
                  "8": "{{3.id}}",
                  "9": "{{3.htmlLink}}",
                  "10": "SCHEDULED"
                }
              },
              "metadata": {
                "designer": { "x": 600, "y": 0 },
                "restore": { "expect": { "from": { "label": "My Drive" }, "mode": { "label": "Select from the list" }, "sheetId": { "mode": "chose", "label": "Interviews" } }, "parameters": { "__IMTCONN__": { "data": { "scoped": "true", "connection": "google" } } } },
                "notes": "Create an Interviews tab with the eleven headers listed in make/SCENARIOS-TO-IMPORT.md, then select it here. Restrict access to authorized agency staff."
              }
            },
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "body": "{\n  \"ok\": true,\n  \"interviewId\": \"{{1.interviewId}}\",\n  \"eventId\": \"{{3.id}}\",\n  \"eventUrl\": \"{{3.htmlLink}}\",\n  \"meetLink\": \"{{ifempty(3.hangoutLink; 1.meetingUrl)}}\",\n  \"sheetRowNumber\": {{4.rowNumber}}\n}",
                "status": "200"
              },
              "metadata": { "designer": { "x": 900, "y": 0 }, "restore": {}, "notes": "The Worker stores eventId and sheetRowNumber on the interview. Those references are supplied on reschedule so the update route reuses the existing event and row." }
            }
          ],
          "filter": { "name": "New interview", "conditions": [[{ "a": "{{1.calendarEventId}}", "b": "", "o": "text:equal:ci" }]] }
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "google-calendar:updateAnEvent",
              "version": 5,
              "parameters": { "__IMTCONN__": "" },
              "mapper": {
                "event": "{{1.calendarEventId}}",
                "calendar": "primary",
                "summary": "Interview with {{1.candidateName}} - At The Agency",
                "allDayEvent": false,
                "start": "{{parseDate(concat(1.scheduledDate; \" \"; 1.scheduledTime24); \"YYYY-MM-DD HH:mm\"; \"Asia/Singapore\")}}",
                "end": "{{addMinutes(parseDate(concat(1.scheduledDate; \" \"; 1.scheduledTime24); \"YYYY-MM-DD HH:mm\"; \"Asia/Singapore\"); ifempty(1.durationMinutes; 30))}}",
                "description": "At The Agency interview\nInterview ID: {{1.interviewId}}\nFormat: {{1.interviewMode}}\nApplication ID: {{1.applicationId}}\n{{ifempty(1.meetingUrl; \"\")}}",
                "location": "{{if(1.interviewMode = \"in_person\"; \"At The Agency\"; ifempty(1.meetingUrl; \"\"))}}",
                "attendees": [{ "email": "{{1.to}}", "displayName": "{{1.candidateName}}" }],
                "transparency": "opaque",
                "visibility": "private",
                "sendUpdates": "all",
                "guestsCanModify": false
              },
              "metadata": {
                "designer": { "x": 300, "y": 600 },
                "restore": { "expect": { "calendar": { "mode": "chose", "label": "Select the agency calendar after import" }, "event": { "mode": "edit" }, "visibility": { "mode": "chose", "label": "Private" }, "sendUpdates": { "mode": "chose", "label": "All" } }, "parameters": { "__IMTCONN__": { "data": { "scoped": "true", "connection": "google" } } } },
                "notes": "Update the saved event and send the calendar change to its guest. The stable event id comes from the website's interview record."
              }
            },
            {
              "id": 9,
              "module": "google-sheets:filterRows",
              "version": 2,
              "parameters": { "__IMTCONN__": "" },
              "mapper": {
                "from": "drive",
                "spreadsheetId": "REPLACE_AFTER_IMPORT",
                "sheetId": "Interviews",
                "includesHeaders": true,
                "tableFirstRow": "A:Z",
                "useColumnHeaders": false,
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING",
                "filter": [[{ "a": "A", "o": "text:equal:ci", "b": "{{1.interviewId}}" }]]
              },
              "metadata": {
                "designer": { "x": 450, "y": 800 },
                "restore": { "expect": { "from": { "label": "My Drive" }, "sheetId": { "mode": "chose", "label": "Interviews" }, "includesHeaders": { "label": "Yes" }, "tableFirstRow": { "label": "A:Z" } }, "parameters": { "__IMTCONN__": { "data": { "scoped": "true", "connection": "google" } } } },
                "notes": "Use Make's smallest supported column range, A:Z; the configured data occupies A:K. Create the eleven headers in A1:K1 before running this scenario. Find the existing sheet row by the stable Interview ID in column A. If no row matches, this update route stops instead of creating a duplicate row; no sort order is needed because Interview ID must be unique."
              }
            },
            {
              "id": 10,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": { "__IMTCONN__": "" },
              "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "REPLACE_AFTER_IMPORT",
                "sheetId": "Interviews",
                "includesHeaders": true,
                "rowNumber": "{{9.rowNumber}}",
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "0": "{{1.interviewId}}",
                  "1": "{{1.applicationId}}",
                  "2": "{{1.candidateName}}",
                  "3": "{{1.to}}",
                  "4": "{{1.scheduledDate}}",
                  "5": "{{1.scheduledTime24}}",
                  "6": "{{1.interviewMode}}",
                  "7": "{{ifempty(6.hangoutLink; 1.meetingUrl)}}",
                  "8": "{{6.id}}",
                  "9": "{{6.htmlLink}}",
                  "10": "RESCHEDULED"
                }
              },
              "metadata": {
                "designer": { "x": 600, "y": 600 },
                "restore": { "expect": { "from": { "label": "My Drive" }, "mode": { "label": "Select from the list" }, "sheetId": { "mode": "chose", "label": "Interviews" } }, "parameters": { "__IMTCONN__": { "data": { "scoped": "true", "connection": "google" } } } },
                "notes": "Update the same sheet row using the saved row number; do not add a second row on reschedule."
              }
            },
            {
              "id": 11,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "body": "{\n  \"ok\": true,\n  \"interviewId\": \"{{1.interviewId}}\",\n  \"eventId\": \"{{6.id}}\",\n  \"eventUrl\": \"{{6.htmlLink}}\",\n  \"meetLink\": \"{{ifempty(6.hangoutLink; 1.meetingUrl)}}\",\n  \"sheetRowNumber\": {{9.rowNumber}}\n}",
                "status": "200"
              },
              "metadata": { "designer": { "x": 900, "y": 600 }, "restore": {}, "notes": "Return the row found by Interview ID; the Worker stores this stable Calendar event and sheet row reference for later reschedules." }
            }
          ],
          "filter": { "name": "Reschedule existing interview", "conditions": [[{ "a": "{{1.calendarEventId}}", "b": "", "o": "text:notequal:ci" }]] }
        }
      ]
    }
  ]
}
