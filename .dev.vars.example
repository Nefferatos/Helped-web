SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_APP_DATA_TABLE=app_data
SUPABASE_APP_DATA_ID=default

# Email confirmations (optional)
# RESEND_API_KEY should be set as a Wrangler secret, not committed.
RESEND_FROM="Helped <no-reply@yourdomain.com>"
DEV_EXPOSE_CONFIRMATION_CODE=false
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...

# Cline AI provider (Kimi K2.6 Code — primary AI for all features)
CLINE_API_KEY=YOUR_CLINE_API_KEY
CLINE_API_URL=https://api.cline.bot/api/v1
CLINE_MODEL=moonshotai/kimi-k2.6

# Fallback: OpenAI-compatible API for PDF autofill
OPENAI_API_KEY=YOUR_OPENAI_COMPATIBLE_API_KEY
OPENAI_BASE_URL=https://api.cline.bot/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

AI_AUTOPILOT_ENABLED=true

# ── Google Sheets agency reports ─────────────────────────────────────────────
# Agency portal "Reports" page -> one Google Sheet tab per data category.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON holds an RSA private key: in production set
# it with `npx wrangler secret put GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON`.
# Locally paste the key JSON on ONE line (escape the newlines as \n).
# Full setup guide: docs/GOOGLE_SHEETS_REPORTS.md
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_SPREADSHEET_ID=1AbC-your-spreadsheet-id

# WEBSITE AI WORKFLOW webhook — backend sends email/calendar/results here
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Workflow web orchestra webhook — website sends AI classification requests here
MAKE_ORCHESTRATOR_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Dedicated HR Interview Email scenario webhook — HR interview emails (pass/fail/invitation)
# are delivered via this Gmail-enabled Make scenario, not the generic router.
MAKE_HR_EMAIL_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Dedicated synchronous Make AI Agent webhook for PDF biodata autofill
MAKE_PDF_AUTOFILL_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_PDF_AUTOFILL_WEBHOOK_TOKEN=your-long-random-secret-here

# Make.com AI Receptionist webhook — when set, the receptionist endpoint
# forwards conversations to Make.com's AI Agent instead of calling the AI directly.
# Create a Custom Webhook in Make.com and paste the URL here.
MAKE_AI_RECEPTIONIST_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
# Optional shared secret sent as X-Webhook-Secret header for validation.
# MAKE_AI_RECEPTIONIST_WEBHOOK_SECRET=your-long-random-secret-here

# Make.com AI Command Center webhook — the AI Agents page bubble chat routes its
# LLM calls EXCLUSIVELY through this webhook (no direct Cline/Claude APIs).
MAKE_AI_COMMAND_CENTER_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
# MAKE_AI_COMMAND_CENTER_WEBHOOK_SECRET=your-long-random-secret-here

# RESEND_API_KEY=re_...   # uncomment + paste your Resend key to test email dispatch locally