# Production build env — committed on purpose.
# These are PUBLIC Supabase values (also present in wrangler.toml [vars]):
#   - the project URL is public
#   - the anon key is designed to be exposed in client code (RLS enforces access)
# Vite auto-loads this file for production builds so the deployed bundle always
# has the Supabase client configured (fixes "Supabase environment variables are missing"
# on the Google/employee login). Do NOT put the service_role key here.
VITE_SUPABASE_URL=https://etdbexgrsenjznxbbnbd.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV0ZGJleGdyc2VuanpueGJibmJkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUxMjY3MjAsImV4cCI6MjA5MDcwMjcyMH0.vtop8R2up7ItNoGXoU1Bx1VAVq23gimj-21nBX4LAg4

# Cline AI API for Command Center chat
# VITE_CLINE_API_KEY intentionally removed — AI provider keys must be Worker secrets.
# Any VITE_* variable is inlined into the public client bundle and readable by anyone.
VITE_CLINE_API_URL=https://api.cline.ai/v1
VITE_CLINE_MODEL=Kimi K2.6 Code
