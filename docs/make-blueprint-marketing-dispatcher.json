{
  "name": "Helped Maids – Full Agentic Dispatcher",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 1, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": -450, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "data": { "editable": "true" }, "label": "Helped Agentic Webhook" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": { "designer": { "x": -150, "y": 0 } },
      "routes": [
        {
          "flow": [
{
              "id": 4,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://graph.facebook.com/v18.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_WHATSAPP_ACCESS_TOKEN" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{1.to}}\",\"type\":\"text\",\"text\":{\"preview_url\":true,\"body\":\"{{1.message}}\"}}"
              },
              "metadata": { "designer": { "x": 450, "y": -500 } }
            }
          ],
          "metadata": {
            "name": "📣 WhatsApp (relay Worker copy)",
            "color": "#25D366",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "whatsapp_marketing", "o": "text:equal" },
              { "a": "{{length(1.to)}}", "b": "9", "o": "number:greater" }
            ]
          }
        },
        {
          "flow": [
{
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_RESEND_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"from\":\"REPLACE_WITH_FROM_EMAIL\",\"to\":[\"{{1.to}}\"],\"subject\":\"{{1.subject}}\",\"text\":\"{{1.message}}\",\"html\":\"{{1.html}}\"}"
              },
              "metadata": { "designer": { "x": 450, "y": -200 } }
            }
          ],
          "metadata": {
            "name": "📧 Email (relay Worker HTML)",
            "color": "#4F46E5",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "email_marketing", "o": "text:equal" },
              { "a": "{{1.to}}", "b": "@", "o": "text:contain" }
            ]
          }
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://graph.facebook.com/v18.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_WHATSAPP_ACCESS_TOKEN" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{1.agencyPhone}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"📋 *New Inquiry — Action Needed*\\n\\nFrom: {{1.name}}\\nContact: {{1.contact}}\\nIntent: {{1.intent}}\\nSource: {{1.source}}\\n\\nMessage: {{left(1.message; 200)}}\\n\\nAI matched {{length(1.matches)}} helper(s). Login to dashboard to review and reply.\"}}"
              },
              "metadata": { "designer": { "x": 150, "y": 100 } }
            }
          ],
          "metadata": {
            "name": "🔔 Inquiry → Admin",
            "color": "#F59E0B",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "inquiry_pipeline", "o": "text:equal" }
            ]
          }
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://graph.facebook.com/v18.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_WHATSAPP_ACCESS_TOKEN" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{1.agencyPhone}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"🆕 *New Lead — {{1.source}}*\\n\\nName: {{1.leadName}}\\nContact: {{1.contact}}\\n\\nRespond within 1 hour for best conversion. Login to dashboard to follow up.\"}}"
              },
              "metadata": { "designer": { "x": 150, "y": 400 } }
            },
            {
              "id": 9,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_RESEND_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"from\":\"REPLACE_WITH_FROM_EMAIL\",\"to\":[\"REPLACE_WITH_AGENCY_ADMIN_EMAIL\"],\"subject\":\"New {{1.source}} lead: {{1.leadName}}\",\"text\":\"New lead received\\n\\nName: {{1.leadName}}\\nContact: {{1.contact}}\\nSource: {{1.source}}\\n\\nLog in to follow up.\",\"html\":\"<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:24px'><h2 style='color:#1a1a1a'>New {{1.source}} Lead</h2><table style='width:100%;border-collapse:collapse'><tr><td style='padding:8px;border-bottom:1px solid #eee;color:#666;width:100px'>Name</td><td style='padding:8px;border-bottom:1px solid #eee;font-weight:600'>{{1.leadName}}</td></tr><tr><td style='padding:8px;border-bottom:1px solid #eee;color:#666'>Contact</td><td style='padding:8px;border-bottom:1px solid #eee;font-weight:600'>{{1.contact}}</td></tr><tr><td style='padding:8px;color:#666'>Source</td><td style='padding:8px;font-weight:600'>{{1.source}}</td></tr></table><br/><a href='REPLACE_WITH_DASHBOARD_URL' style='display:inline-block;background:#4F46E5;color:white;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:600'>Open Dashboard</a></div>\"}"
              },
              "metadata": { "designer": { "x": 450, "y": 400 } }
            }
          ],
          "metadata": {
            "name": "🆕 Lead → Admin",
            "color": "#EF4444",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "lead_pipeline", "o": "text:equal" }
            ]
          }
        },
        {
          "flow": [
            {
              "id": 10,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDecompress": true },
              "mapper": {
                "url": "https://graph.facebook.com/v18.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_WHATSAPP_ACCESS_TOKEN" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{1.agencyPhone}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"🤖 *AI Autopilot Update — {{1.agencyName}}*\\n\\n{{1.actionCount}} action(s) drafted | {{1.highPriorityCount}} high priority\\n\\n{{1.summaryText}}\\n\\nLogin to review and approve AI drafts.\"}}"
              },
              "metadata": { "designer": { "x": 150, "y": 700 } }
            }
          ],
          "metadata": {
            "name": "🤖 Autopilot → Admin",
            "color": "#7C3AED",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "autopilot_notification", "o": "text:equal" },
              { "a": "{{1.actionCount}}", "b": "0", "o": "number:greater" }
            ]
          }
        },
        {
          "flow": [],
          "metadata": { "name": "⬛ Fallback", "color": "#9CA3AF", "conditions": [] }
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 10,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com"
  }
}
