                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{2.notifyPhone}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"📋 *New Inquiry — Action Needed*\\n\\nFrom: {{1.name}}\\nContact: {{1.contact}}\\nIntent: {{1.intent}}\\nSource: {{1.source}}\\n\\nMessage: {{left(1.message; 200)}}\\n\\nAI matched {{length(1.matches)}} helper(s). Login to dashboard to review and reply.\"}}"
              },
