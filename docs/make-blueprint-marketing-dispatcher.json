                "body": "{\"from\":\"REPLACE_WITH_FROM_EMAIL\",\"to\":[\"REPLACE_WITH_AGENCY_ADMIN_EMAIL\"],\"subject\":\"New {{1.source}} lead: {{1.leadName}}\",\"text\":\"New lead received\\n\\nName: {{1.leadName}}\\nContact: {{1.contact}}\\nSource: {{1.source}}\\n\\nLog in to follow up.\",\"html\":\"<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:24px'><h2 style='color:#1a1a1a'>New {{1.source}} Lead</h2><table style='width:100%;border-collapse:collapse'><tr><td style='padding:8px;border-bottom:1px solid #eee;color:#666;width:120px'>Name</td><td style='padding:8px;border-bottom:1px solid #eee;font-weight:600'>{{1.leadName}}</td></tr><tr><td style='padding:8px;border-bottom:1px solid #eee;color:#666'>Contact</td><td style='padding:8px;border-bottom:1px solid #eee;font-weight:600'>{{1.contact}}</td></tr><tr><td style='padding:8px;color:#666'>Source</td><td style='padding:8px;font-weight:600'>{{1.source}}</td></tr></table><br/><a href='REPLACE_WITH_DASHBOARD_URL' style='display:inline-block;background:#4F46E5;color:white;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:600'>Open Dashboard</a></div>\"}"
              },
              "metadata": {
                "designer": { "x": 700, "y": 120 }
              }
            }
          ],
          "metadata": {
            "name": "🆕 New Lead Alert",
            "color": "#EF4444",
            "conditions": [
