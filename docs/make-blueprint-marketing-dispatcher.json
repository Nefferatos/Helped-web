{
  "name": "Helped Maids – Full Agentic Dispatcher",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 1,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": -450, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "data": { "editable": "true" },
              "label": "Helped Agentic Webhook"
            }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "tools:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "formattedPhone",
            "value": "{{if(length(replace(replace(replace(replace(replace(1.to; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\")) = 8; \"65\" & replace(replace(replace(replace(replace(1.to; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\"); replace(replace(replace(replace(replace(1.to; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\"))}}"
          },
          {
            "name": "notifyPhone",
            "value": "{{if(length(replace(replace(replace(replace(replace(1.agencyPhone; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\")) > 9; replace(replace(replace(replace(replace(1.agencyPhone; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\"); if(length(replace(replace(replace(replace(replace(1.agencyPhone; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\")) = 8; \"65\" & replace(replace(replace(replace(replace(1.agencyPhone; \"+\"; \"\"); \" \"; \"\"); \"-\"; \"\"); \"(\"; \"\"); \")\"; \"\"); \"REPLACE_WITH_AGENCY_ADMIN_PHONE\"))}}"
          }
        ]
      },
      "metadata": {
        "designer": { "x": -200, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 100, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDecompress": true
              },
              "mapper": {
                "url": "https://graph.facebook.com/v18.0/REPLACE_WITH_PHONE_NUMBER_ID/messages",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_WHATSAPP_ACCESS_TOKEN" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"messaging_product\":\"whatsapp\",\"recipient_type\":\"individual\",\"to\":\"{{2.formattedPhone}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"{{1.message}}\"}}"
              },
              "metadata": {
                "designer": { "x": 400, "y": -600 }
              }
            }
          ],
          "metadata": {
            "name": "📣 WhatsApp Marketing",
            "color": "#25D366",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "whatsapp_marketing", "o": "text:equal" },
              { "a": "{{length(2.formattedPhone)}}", "b": "9", "o": "number:greater" }
            ]
          }
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDecompress": true
              },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_RESEND_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "body": "{\"from\":\"REPLACE_WITH_FROM_EMAIL\",\"to\":[\"{{1.to}}\"],\"subject\":\"{{1.subject}}\",\"text\":\"{{1.message}}\",\"html\":\"<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:24px'><p style='font-size:15px;line-height:1.7;color:#1a1a1a'>{{replace(1.message; '\\n'; '<br>')}}</p><hr style='border:none;border-top:1px solid #e5e7eb;margin:24px 0'/><p style='font-size:12px;color:#6b7280'>Sent by {{1.agencyName}}. Reply STOP to unsubscribe.</p></div>\"}"
              },
              "metadata": {
                "designer": { "x": 400, "y": -360 }
              }
            }
          ],
          "metadata": {
            "name": "📧 Email Marketing",
            "color": "#4F46E5",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "email_marketing", "o": "text:equal" },
              { "a": "{{1.to}}", "b": "@", "o": "text:contain" }
            ]
          }
        },
        {
          "flow": [
            {
