              },
              "metadata": {
                "designer": { "x": 400, "y": 360 }
              }
            }
          ],
          "metadata": {
            "name": "🤖 Autopilot Notify Admin",
            "color": "#7C3AED",
            "conditions": [
              { "a": "{{1.scenario}}", "b": "autopilot_notification", "o": "text:equal" },
              { "a": "{{1.actionCount}}", "b": "0", "o": "number:greater" }
