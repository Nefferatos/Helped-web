# ============================================================================
#  Template for Helped-web's LOCAL secret files (all gitignored).
#
#  Copy the section you need into the matching file:
#
#    .env          (repo root)  API keys + Make.com webhooks. Loaded by the
#                               Express backend (backend/src/loadRootEnv.ts) and
#                               by scripts run as
#                               `node --env-file=.env scripts/<name>.mjs`
#    .dev.vars     (repo root)  The same keys for the Cloudflare Worker —
#                               Wrangler only reads this filename.
#                               See .dev.vars.example.
#    backend/.env               Backend-only: PORT, DATABASE_URL, SMTP_*.
#    frontend/.env              VITE_* only. Everything prefixed VITE_ is PUBLIC
#                               in the browser bundle — never put a key there.
#
#  Never commit any of them. `npm run secrets:scan` blocks a commit that
#  contains a real secret value.
# ============================================================================

# ── .env (repo root): Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_APP_DATA_TABLE=app_data
SUPABASE_APP_DATA_ID=default

# ── .env (repo root): AI providers ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...
ANTHROPIC_MODEL=claude-haiku-4-5
CLAUDE_API_KEY=sk-ant-...your-anthropic-key...
CLAUDE_MODEL=claude-3-5-haiku-latest
CLINE_API_KEY=YOUR_CLINE_API_KEY
CLINE_API_URL=https://api.cline.bot/api/v1
CLINE_MODEL=Kimi K2.6 Code
OPENAI_API_KEY=YOUR_OPENAI_COMPATIBLE_API_KEY
OPENAI_BASE_URL=https://api.cline.bot/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=YOUR_GROQ_API_KEY
AI_AUTOPILOT_ENABLED=true

# ── .env (repo root): event spine ───────────────────────────────────────────
# Shared secret that Make.com sends as the `x-event-secret` header when it
# reports a result back to POST /api/events. Any long random string.
EVENT_INGEST_SECRET=your-long-random-secret-here

# ── .env (repo root): Make.com webhooks ────────────────────────────────────
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
# Event-driven applicant intake (#2): the backend POSTs here the instant a
# candidate.created event is recorded, replacing the old 15-min Supabase poll.
# Copy the webhook URL from the 'Applicant Intake (event)' Custom Webhook module.
MAKE_WEBHOOK_URL_APPLICANT_INTAKE=https://hook.eu1.make.com/your-webhook-id
# Unified Make AI gateway. Set MAKE_WEBHOOK_URL_AI_ENGINE to one generic
# gateway webhook, or set the scenario-specific overrides below.
MAKE_WEBHOOK_URL_AI_ENGINE=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_AI_ENGINE_WORKFLOW=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_AI_ENGINE_MARKETING=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_AI_ENGINE_RECEPTIONIST=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_AI_ENGINE_PDF_AUTOFILL=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_AI_ENGINE_HR_INTERVIEWER=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_CONTRACTOR_ARRIVAL_ALERT=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_INTERVIEW_SCHEDULED_ALERT=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_GOOGLE_DRIVE_SYNC=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_MEDIA_TRANSCRIBE=https://hook.eu1.make.com/your-webhook-id
MAKE_WEBHOOK_URL_APPLICANT_ASSISTANT=https://hook.eu1.make.com/your-webhook-id
MAKE_ORCHESTRATOR_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_HR_EMAIL_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_PDF_AUTOFILL_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_PDF_AUTOFILL_WEBHOOK_TOKEN=your-long-random-secret-here
# Worker-only webhooks: put these in .dev.vars locally and Wrangler secrets in
# production. Keep them out of frontend/.env because VITE_* values are public.
MAKE_AI_RECEPTIONIST_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_AI_HR_INTERVIEWER_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
MAKE_AI_COMMAND_CENTER_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# ── .env (repo root): Google Sheets agency reports ──────────────────────────
# The agency portal "Reports" page pushes every data category to its own tab in
# a Google Spreadsheet (maids, enquiries, requests, contracts, applicants, ...).
# Consumed by the Cloudflare Worker, so these belong in .dev.vars locally and as
# Wrangler secrets in production. See docs/GOOGLE_SHEETS_REPORTS.md.
#
# Full service-account key JSON (Google Cloud -> IAM & Admin -> Service Accounts
# -> Keys -> Add key -> JSON). Contains an RSA private key: keep it secret.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Default spreadsheet id, or a full
# https://docs.google.com/spreadsheets/d/<ID>/edit URL. Agencies can override
# this per-agency from the Reports page.
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── .env (repo root): email ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Helped <no-reply@yourdomain.com>"
DEV_EXPOSE_CONFIRMATION_CODE=false

# ─ backend/.env (backend-only) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:port/db
PORT=3000
CORS_ORIGIN=http://localhost:8080
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_POOL=true
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_MIN_VERSION=TLSv1.2
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Helped <your-smtp-username>"
MAIL_TELL_FRIEND_MAX_MESSAGE_BYTES=5000
MAIL_SEND_TIMEOUT_MS=8000

# ─ frontend/.env (PUBLIC — ends up in the browser bundle) ──────────────────
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_MAKE_WEBHOOK_URL_INQUIRY_PIPELINE=
VITE_MAKE_WEBHOOK_URL_LEAD_PIPELINE=
VITE_MAKE_WEBHOOK_URL_INTERVIEW_PIPELINE=
